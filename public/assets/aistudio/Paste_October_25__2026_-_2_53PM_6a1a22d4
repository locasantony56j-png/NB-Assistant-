  const pauseRef = useRef<Record<string, boolean>>({});
  const suggestions = repeatedCommands(actions.map((a) => a.command)).filter((s) => !workflows.some((w) => w.source.toLowerCase() === s.text.toLowerCase())).slice(0, 3);
  const routines = modes.find((m) => m.id === activeMode)?.routines ?? [];

  const build = async (src = text) => {
    if (src.trim().length < 3) return;
    setBusy(true);
    const apps = [...BUILTIN_APPS, ...getState().customApps].map((a) => a.id);
    const r = await buildWorkflow({ data: { text: src, now: new Date().toString(), apps } }).catch(() => ({ ok: false as const, error: "Network error." }));
    setBusy(false);

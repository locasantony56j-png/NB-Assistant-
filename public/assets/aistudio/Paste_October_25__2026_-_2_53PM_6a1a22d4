            target={web && a.web.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            aria-disabled={!web}
            onClick={(e) => {
              if (internal) { e.preventDefault(); navigate({ to: a.web as "/" }); return; }
              logAction({
                command: `Tap ${a.name}`, app: a.name, action: "Open app",
                result: web ? "Link opened." : "Needs the NB Android app to open.",
                status: web ? "needs_user" : "failed",
              });
            }}
            className={cn("group flex min-w-0 flex-col items-center gap-2 rounded-xl border bg-card p-3 text-center transition hover:border-primary", !web && "opacity-60")}

import { useEffect, useState } from "react";
import { Button } from "@/components/ui/button";
import { Download } from "lucide-react";

interface BeforeInstallPromptEvent extends Event {
  prompt: () => Promise<void>;
  userChoice: Promise<{ outcome: "accepted" | "dismissed" }>;
}

let deferredPrompt: BeforeInstallPromptEvent | null = null;
const listeners = new Set<(v: boolean) => void>();

function notify() {
  listeners.forEach((l) => l(!!deferredPrompt));
}

if (typeof window !== "undefined") {
  window.addEventListener("beforeinstallprompt", (e) => {
    // Take over the browser banner so NB shows its own Install button.
    e.preventDefault();
    deferredPrompt = e as BeforeInstallPromptEvent;
    notify();
  });
  window.addEventListener("appinstalled", () => {
    deferredPrompt = null;
    notify();
  });
}

function useInstallAvailable() {
  const [available, setAvailable] = useState(!!deferredPrompt);
  useEffect(() => {
    listeners.add(setAvailable);
    notify();
    return () => {
      listeners.delete(setAvailable);
    };
  }, []);
  return available;
}

export function InstallButton({ className, variant }: { className?: string; variant?: "default" | "outline" | "ghost" | "secondary" | "destructive" | "link" }) {
  const available = useInstallAvailable();
  const [installed, setInstalled] = useState(false);
  if (!available || installed) return null;
  return (
    <Button
      size="sm"
      variant={variant}
      className={className}
      onClick={async () => {
        const p = deferredPrompt;
        if (!p) return;
        try {
          await p.prompt();
          const choice = await p.userChoice.catch(() => null);
          if (choice?.outcome === "accepted") {
            deferredPrompt = null;
            setInstalled(true);
            notify();
          }
        } catch {
          // prompt failed; keep the button so the user can retry
        }
      }}
    >
      <Download /> Add to home screen
    </Button>
  );
}


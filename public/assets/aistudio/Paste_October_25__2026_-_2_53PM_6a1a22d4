package com.example.nb

// UNTESTED skeleton. Optional, user-enabled. Performs ONE requested action on visible UI
// and reports whether it was dispatched/verified. Never stores message contents.
import android.accessibilityservice.AccessibilityService
import android.os.Bundle
import android.view.accessibility.AccessibilityEvent
import android.view.accessibility.AccessibilityNodeInfo

class NbAccessibilityService : AccessibilityService() {
  companion object { var instance: NbAccessibilityService? = null }

  override fun onServiceConnected() { instance = this }
  override fun onDestroy() { instance = null; super.onDestroy() }
  override fun onAccessibilityEvent(event: AccessibilityEvent?) { /* intentionally not logging content */ }
  override fun onInterrupt() {}

  fun currentPackage(): String = rootInActiveWindow?.packageName?.toString() ?: ""

  /** Click the first visible node whose text or content-description matches (e.g. "Send", "Like", "Video call"). */
  fun clickByText(label: String): Boolean {
    val root = rootInActiveWindow ?: return false
    val node = root.findAccessibilityNodeInfosByText(label).firstOrNull { it.isVisibleToUser } ?: return false
    var n: AccessibilityNodeInfo? = node
    while (n != null && !n.isClickable) n = n.parent
    return n?.performAction(AccessibilityNodeInfo.ACTION_CLICK) ?: false
  }

  /** Type into the focused editable field. Verifies by reading the field text back. */
  fun typeText(text: String): Boolean {
    val root = rootInActiveWindow ?: return false
    val field = root.findFocus(AccessibilityNodeInfo.FOCUS_INPUT) ?: return false
    val args = Bundle().apply { putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, text) }
    field.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args)
    field.refresh()
    return field.text?.toString() == text
  }

  private fun firstScrollable(n: AccessibilityNodeInfo?): AccessibilityNodeInfo? {
    if (n == null) return null
    if (n.isScrollable) return n
    for (i in 0 until n.childCount) firstScrollable(n.getChild(i))?.let { return it }
    return null
  }

  fun scrollForward(): Boolean = firstScrollable(rootInActiveWindow)?.performAction(AccessibilityNodeInfo.ACTION_SCROLL_FORWARD) ?: false
  fun scrollBackward(): Boolean = firstScrollable(rootInActiveWindow)?.performAction(AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD) ?: false
  fun back(): Boolean = performGlobalAction(GLOBAL_ACTION_BACK)

  /** Collects visible text (capped) so NB can read it aloud on request. */
  fun visibleText(max: Int): String {
    val sb = StringBuilder()
    fun walk(n: AccessibilityNodeInfo?) {
      if (n == null || sb.length >= max) return
      if (n.isVisibleToUser) (n.text ?: n.contentDescription)?.let { if (it.isNotBlank()) sb.append(it).append('\n') }
      for (i in 0 until n.childCount) walk(n.getChild(i))
    }
    walk(rootInActiveWindow)
    return sb.take(max).toString()
  }
}


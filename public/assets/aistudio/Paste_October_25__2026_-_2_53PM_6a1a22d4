// Pure logic for planner, modes, workflows, preferences and safety guards. No React, easy to test.
import type { PlanStep } from "./planner.functions";

export type Priority = "high" | "medium" | "low";
export type TaskKind = "class" | "office" | "meeting" | "deadline" | "goal" | "personal";
export type Task = {
  id: string; title: string; kind: TaskKind; priority: Priority; due: string | null;
  recurrence: "none" | "daily" | "weekly" | "weekdays"; dependsOn: string[]; done: boolean; notes?: string;
};
export type ModeId = "personal" | "study" | "office" | "developer" | "travel";
export type Mode = { id: ModeId; name: string; apps: string[]; routines: string[]; note: string };
export type Workflow = { id: string; name: string; source: string; steps: PlanStep[]; createdAt: string };
export type RunStepLog = { index: number; label: string; status: "done" | "needs_user" | "skipped" | "failed" | "cancelled" | "simulated"; detail: string };
export type WorkflowRun = {
  id: string; workflowId: string; name: string; at: string; test: boolean;
  status: "running" | "paused" | "completed" | "cancelled" | "failed"; nextIndex: number; logs: RunStepLog[];
};
export type Preference = { id: string; text: string; createdAt: string };

export const DEFAULT_MODES: Mode[] = [
  { id: "personal", name: "Personal", apps: [], routines: [], note: "All apps allowed." },
  { id: "study", name: "Study", apps: ["youtube", "google", "chrome"], routines: [], note: "Focus on learning apps." },
  { id: "office", name: "Office", apps: ["gmail", "google", "chrome", "maps"], routines: [], note: "Work apps only." },
  { id: "developer", name: "Developer", apps: ["chrome", "google", "youtube"], routines: [], note: "Docs and browser." },
  { id: "travel", name: "Travel", apps: ["maps", "google", "whatsapp"], routines: [], note: "Maps and contacts." },
];

const PRI: Record<Priority, number> = { high: 0, medium: 1, low: 2 };

/** IDs of unfinished tasks that block this one. */
export function blockers(task: Task, all: Task[]): string[] {
  return task.dependsOn.filter((id) => all.find((t) => t.id === id && !t.done));
}

/** Would adding dep -> task create a cycle? */
export function createsCycle(taskId: string, depId: string, all: Task[]): boolean {
  const seen = new Set<string>();
  const walk = (id: string): boolean => {
    if (id === taskId) return true;
    if (seen.has(id)) return false;
    seen.add(id);
    return (all.find((t) => t.id === id)?.dependsOn ?? []).some(walk);
  };
  return walk(depId);
}

export function sameDay(a: Date, b: Date) {
  return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
}

export function dailySummary(tasks: Task[], now = new Date()) {
  const open = tasks.filter((t) => !t.done);
  const sort = (x: Task[]) => [...x].sort((a, b) => PRI[a.priority] - PRI[b.priority] || (a.due ?? "").localeCompare(b.due ?? ""));
  const overdue = sort(open.filter((t) => t.due && new Date(t.due) < now && !sameDay(new Date(t.due), now)));
  const today = sort(open.filter((t) => t.due && sameDay(new Date(t.due), now)));
  const blocked = open.filter((t) => blockers(t, tasks).length > 0);
  const text = `Today: ${today.length} task(s), ${overdue.length} overdue, ${blocked.length} blocked.` +
    (today[0] ? ` Top: ${today[0].title} (${today[0].priority}).` : "");
  return { overdue, today, blocked, text };
}

/** Is an app allowed in the active mode? Empty list = everything allowed. */
export function appAllowed(mode: Mode | undefined, appId: string | null | undefined) {
  if (!mode || mode.apps.length === 0 || !appId) return true;
  return mode.apps.includes(appId.toLowerCase());
}

/** Fingerprint of an irreversible action, so we can block accidental repeats. */
export function actionKey(step: Pick<PlanStep, "type" | "app" | "contact" | "message">) {
  return [step.type, step.app ?? "", (step.contact ?? "").toLowerCase().trim(), (step.message ?? "").trim()].join("|");
}
export const DUPLICATE_WINDOW_MS = 10 * 60 * 1000;
export function isDuplicate(key: string, recent: { key: string; at: string }[], now = Date.now()) {
  return recent.some((r) => r.key === key && now - +new Date(r.at) < DUPLICATE_WINDOW_MS);
}

/** Preferences must never hold secrets: passwords, OTPs, card or long account numbers. */
export function isSensitive(text: string) {
  return /\b(password|passcode|otp|pin|cvv|card number|bkash pin)\b/i.test(text) || /\d{6,}/.test(text.replace(/[\s-]/g, ""));
}

/** Commands repeated 3+ times (case-insensitive) become workflow suggestions. */
export function repeatedCommands(commands: string[], min = 3) {
  const c = new Map<string, { text: string; n: number }>();
  for (const cmd of commands) {
    const k = cmd.toLowerCase().trim();
    if (!k) continue;
    const e = c.get(k) ?? { text: cmd.trim(), n: 0 };
    e.n++; c.set(k, e);
  }
  return [...c.values()].filter((e) => e.n >= min).sort((a, b) => b.n - a.n);
}

export function stepLabel(s: PlanStep) {
  switch (s.type) {
    case "open_app": return `Open ${s.app}`;
    case "search": return `Search ${s.app ?? "web"} for "${s.query}"`;
    case "compose_message": return `Prepare ${s.app} message to ${s.contact}: "${s.message}"`;
    case "call": return `Call ${s.contact}`;
    case "reminder": return `Reminder "${s.message}" at ${s.when}`;
    case "navigate_nb": return `Open NB page ${s.app}`;
    default: return s.type;
  }
}
export function stepPermission(s: PlanStep) {
  if (s.type === "compose_message" || s.type === "call") return "Your confirmation every run";
  if (s.type === "reminder") return "Notifications (to ring)";
  if (s.type === "open_app" || s.type === "search") return "Pop-ups / opening links";
  return "None";
}

/** Minimal .ics for one task — the user downloads and imports it themselves. */
export function toIcs(t: Task) {
  const d = new Date(t.due ?? Date.now());
  const f = (x: Date) => x.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");
  const end = new Date(d.getTime() + 30 * 60000);
  const rr = t.recurrence === "daily" ? "RRULE:FREQ=DAILY\r\n" : t.recurrence === "weekly" ? "RRULE:FREQ=WEEKLY\r\n" : t.recurrence === "weekdays" ? "RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR\r\n" : "";
  return `BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//NB//EN\r\nBEGIN:VEVENT\r\nUID:${t.id}@nb\r\nDTSTAMP:${f(new Date())}\r\nDTSTART:${f(d)}\r\nDTEND:${f(end)}\r\n${rr}SUMMARY:${t.title.replace(/[,;\n]/g, " ")}\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n`;
}

export function download(name: string, content: string, type = "application/json") {
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([content], { type }));
  a.download = name; a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

const NB_NAME = /(^|[\s,.!?।:;"'])(?:(?:hey|hi|ok|okay|হেই|ওকে)[\s,]+)?(n\.?\s?b\.?|en\s?bee|en\s?bi|এন\s?বি|এনবি)(?=$|[\s,.!?।:;"'])/i;
/**
 * Always-on "say NB first" rule. Returns null when NB's name wasn't said,
 * "" when only the name was said, otherwise the command after the name.
 */
export function extractNbCommand(text: string): string | null {
  const m = NB_NAME.exec(text);
  if (!m) return null;
  return text.slice(m.index + m[0].length).replace(/^[\s,.!?।:;"'-]+/, "").trim();
}

export type Contact = { id: string; name: string; phone: string };
const norm = (s: string) => s.toLowerCase().replace(/\s+/g, " ").trim();
/** Turn a spoken name or number into a phone number using NB's saved contacts. */
export function resolveContact(spoken: string | null | undefined, contacts: Contact[]): { name: string; phone: string } | null {
  if (!spoken) return null;
  const digits = spoken.replace(/[^\d+]/g, "");
  if (digits.replace("+", "").length >= 6) return { name: spoken, phone: digits };
  const n = norm(spoken).replace(/^(amar|my|আমার)\s+/, "").replace(/\s+(ke|কে|re|রে)$/, "");
  if (!n) return null;
  const hit = contacts.find((c) => norm(c.name) === n)
    ?? contacts.find((c) => norm(c.name).split(" ").includes(n))
    ?? contacts.find((c) => norm(c.name).includes(n) || n.includes(norm(c.name)));
  return hit ? { name: hit.name, phone: hit.phone.replace(/[^\d+]/g, "") } : null;
}


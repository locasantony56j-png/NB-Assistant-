/* Cloud listening: records each spoken phrase with the microphone and sends it to NB's
   speech-to-text service. Used when the browser's own speech service is missing or fails
   (common inside Android app wrappers). Only call from event handlers/effects. */
import { isSpeaking } from "./speech";

export type CloudListener = { start: () => Promise<boolean>; stop: () => void };

function pickMime(): string {
  const MR = (window as unknown as { MediaRecorder?: typeof MediaRecorder }).MediaRecorder;
  if (!MR) return "";
  for (const m of ["audio/webm;codecs=opus", "audio/webm", "audio/mp4", "audio/ogg;codecs=opus"]) {
    if (MR.isTypeSupported?.(m)) return m;
  }
  return "";
}

export const cloudSupported = () =>
  typeof window !== "undefined" && !!navigator.mediaDevices?.getUserMedia && "MediaRecorder" in window;

export function createCloudListener(opts: {
  continuous: boolean;
  onText: (text: string) => void;
  onError: (msg: string, fatal: boolean) => void;
  onBusy?: (busy: boolean) => void;
}): CloudListener {
  let stream: MediaStream | null = null;
  let ctx: AudioContext | null = null;
  let timer: number | null = null;
  let rec: MediaRecorder | null = null;
  let stopped = false;
  let floor = 0.01;
  let voiceMs = 0;
  let silenceMs = 0;
  let startedAt = 0;

  const send = async (blob: Blob) => {
    if (blob.size < 2000) return;
    opts.onBusy?.(true);
    try {
      const fd = new FormData();
      const type = blob.type.split(";")[0] || "audio/webm";
      fd.append("file", new File([blob], type.includes("mp4") ? "speech.m4a" : "speech.webm", { type }));
      const res = await fetch("/api/public/transcribe", { method: "POST", body: fd });
      const body = (await res.json().catch(() => ({}))) as { text?: string; error?: string };
      if (!res.ok) { opts.onError(body.error ?? "Voice service error.", res.status === 402); return; }
      const t = (body.text ?? "").trim();
      if (t.length > 1 && !stopped) opts.onText(t);
    } catch {
      opts.onError("No internet connection. NB will keep trying.", false);
    } finally {
      opts.onBusy?.(false);
    }
  };

  const beginSegment = () => {
    if (!stream) return;
    const mime = pickMime();
    const chunks: Blob[] = [];
    const r = mime ? new MediaRecorder(stream, { mimeType: mime }) : new MediaRecorder(stream);
    r.ondataavailable = (e) => { if (e.data.size) chunks.push(e.data); };
    r.onstop = () => {
      const voiced = voiceMs;
      if (voiced >= 250 && !stopped) void send(new Blob(chunks, { type: r.mimeType || mime || "audio/webm" }));
      if (!opts.continuous && voiced >= 250) releaseMic();
    };
    r.start();
    rec = r; voiceMs = 0; silenceMs = 0; startedAt = Date.now();
  };

  const endSegment = () => { if (rec && rec.state !== "inactive") rec.stop(); rec = null; };

  const start = async () => {
    stopped = false;
    try {
      stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
    } catch (e) {
      const name = (e as { name?: string }).name;
      opts.onError(name === "NotAllowedError" ? "Microphone permission was denied. Allow it in your phone settings for this app." : "No microphone found.", true);
      return false;
    }
    const AC = window.AudioContext ?? (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
    ctx = new AC();
    const src = ctx.createMediaStreamSource(stream);
    const an = ctx.createAnalyser();
    an.fftSize = 1024;
    src.connect(an);
    const buf = new Float32Array(an.fftSize);
    const STEP = 50;
    timer = window.setInterval(() => {
      if (!ctx) return;
      if (ctx.state === "suspended") void ctx.resume();
      an.getFloatTimeDomainData(buf);
      let sum = 0;
      for (let i = 0; i < buf.length; i++) sum += buf[i]! * buf[i]!;
      const rms = Math.sqrt(sum / buf.length);
      const loud = rms > Math.max(0.012, floor * 2.8);
      if (!rec) {
        floor = floor * 0.95 + rms * 0.05; // learn background noise
        if (loud && !isSpeaking()) beginSegment();
        return;
      }
      if (loud) { voiceMs += STEP; silenceMs = 0; } else silenceMs += STEP;
      const long = Date.now() - startedAt > 10000;
      if (silenceMs > 400 || long || isSpeaking()) endSegment();
    }, STEP);
    return true;
  };

  function stop() {
    stopped = true;
    releaseMic();
  }

  function releaseMic() {
    if (timer) window.clearInterval(timer);
    timer = null;
    endSegment();
    stream?.getTracks().forEach((t) => t.stop());
    stream = null;
    void ctx?.close().catch(() => {});
    ctx = null;
  }

  return { start, stop };
}


import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogContent, AlertDialogDescription, AlertDialogFooter, AlertDialogHeader, AlertDialogTitle } from "@/components/ui/alert-dialog";
import { useAssistant } from "./AssistantProvider";

export function ConfirmDialog() {
  const { confirm, approve, reject } = useAssistant();
  return (
    <AlertDialog open={!!confirm} onOpenChange={(o) => !o && reject()}>
      <AlertDialogContent>
        <AlertDialogHeader>
          <AlertDialogTitle>Confirm this action</AlertDialogTitle>
          <AlertDialogDescription>{confirm?.summary}</AlertDialogDescription>
        </AlertDialogHeader>
        <p className="text-sm text-muted-foreground">
          NB will open the app with everything ready. For your safety, you press the final Send or Call button yourself.
        </p>
        <AlertDialogFooter>
          <AlertDialogCancel onClick={reject}>Cancel</AlertDialogCancel>
          <AlertDialogAction onClick={approve}>Yes, continue</AlertDialogAction>
        </AlertDialogFooter>
      </AlertDialogContent>
    </AlertDialog>
  );
}


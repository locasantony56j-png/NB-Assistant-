package com.example.nb

// UNTESTED until built and tried on a real phone.
// Background "NB" listening: a foreground service (visible notification, mic type) runs Android's
// own SpeechRecognizer in a loop, preferring the on-device (offline) model. When a phrase contains
// "NB", the rest is the command; it is handed to the NB web app (NbActionsPlugin "command" event).
// Android rules this respects:
//  - Must be started while NB is open on screen (Android 14 blocks starting mic services from background).
//  - The notification is always visible; its Stop button ends listening immediately.
//  - Opening NB from the background is limited on Android 10+; if blocked, a "NB heard…" notification
//    is shown and the user taps it. Screen-off listening works only if the phone doesn't kill the service
//    (turn off battery optimisation for NB).
import android.app.*
import android.content.Context
import android.content.Intent
import android.content.pm.ServiceInfo
import android.os.Build
import android.os.Bundle
import android.os.Handler
import android.os.IBinder
import android.os.Looper
import android.os.PowerManager
import android.speech.RecognitionListener
import android.speech.RecognizerIntent
import android.speech.SpeechRecognizer

class VoiceForegroundService : Service() {
  companion object {
    @Volatile var running = false
    @Volatile var pendingCommand: String? = null
    /** Last problem the listener hit (null = fine); reported to the web app by backgroundStatus. */
    @Volatile var lastError: String? = null
    var onCommand: ((String) -> Unit)? = null
    private val WAKE = Regex("""^(?:.*?\b)?(?:hey\s+|hi\s+|ok\s+)?(?:n\.?\s?b\.?|en\s?bee|enbi|এনবি|এন বি)\b[\s,.!?।]*(.*)$""", RegexOption.IGNORE_CASE)

    /** Returns null when "NB" wasn't said, "" when only the name, otherwise the command. */
    fun extract(text: String): String? = WAKE.find(text.trim())?.groupValues?.get(1)?.trim()

    fun start(ctx: Context, lang: String) {
      val i = Intent(ctx, VoiceForegroundService::class.java).putExtra("lang", lang)
      if (Build.VERSION.SDK_INT >= 26) ctx.startForegroundService(i) else ctx.startService(i)
    }
    fun stop(ctx: Context) { ctx.startService(Intent(ctx, VoiceForegroundService::class.java).setAction("STOP")) }
  }

  private val main = Handler(Looper.getMainLooper())
  private var recognizer: SpeechRecognizer? = null
  private var lang = "bn-BD"
  private var armedUntil = 0L
  private var failures = 0
  private var useOnDevice = true
  private var wake: PowerManager.WakeLock? = null

  override fun onBind(intent: Intent?): IBinder? = null

  override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
    if (intent?.action == "STOP") { shutdown(); return START_NOT_STICKY }
    lang = intent?.getStringExtra("lang") ?: lang
    val ch = "nb_listening"
    val nm = getSystemService(NotificationManager::class.java)
    if (Build.VERSION.SDK_INT >= 26) {
      nm.createNotificationChannel(NotificationChannel(ch, "NB listening", NotificationManager.IMPORTANCE_LOW))
      nm.createNotificationChannel(NotificationChannel("nb_heard", "NB heard a command", NotificationManager.IMPORTANCE_HIGH))
    }
    val stop = PendingIntent.getService(this, 0, Intent(this, VoiceForegroundService::class.java).setAction("STOP"), PendingIntent.FLAG_IMMUTABLE)
    val n = Notification.Builder(this, ch)
      .setContentTitle("NB is listening — say \"NB\"")
      .setSmallIcon(android.R.drawable.ic_btn_speak_now)
      .addAction(Notification.Action.Builder(null, "Stop", stop).build())
      .setOngoing(true).build()
    try {
      if (Build.VERSION.SDK_INT >= 30) startForeground(1, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE) else startForeground(1, n)
    } catch (e: Exception) { stopSelf(); return START_NOT_STICKY } // Android refused (started from background)
    running = true
    // Partial wake lock keeps the CPU running while the screen is off.
    wake = (getSystemService(POWER_SERVICE) as PowerManager).newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "nb:listen").apply { setReferenceCounted(false); acquire(6 * 60 * 60 * 1000L) }
    main.post { listen() }
    return START_STICKY
  }

  private fun listen() {
    if (!running) return
    if (!SpeechRecognizer.isRecognitionAvailable(this)) { lastError = "no_speech_service"; main.postDelayed({ listen() }, 10_000); return }
    // Renew the CPU wake lock so listening survives past its timeout with the screen off.
    wake?.let { if (!it.isHeld) it.acquire(60 * 60 * 1000L) }
    recognizer?.destroy()
    // On-device model is preferred, but if its language pack is missing we fall back to the normal service.
    val r = if (useOnDevice && Build.VERSION.SDK_INT >= 31 && SpeechRecognizer.isOnDeviceRecognitionAvailable(this))
      SpeechRecognizer.createOnDeviceSpeechRecognizer(this) else SpeechRecognizer.createSpeechRecognizer(this)
    recognizer = r
    r.setRecognitionListener(object : RecognitionListener {
      override fun onResults(b: Bundle?) {
        failures = 0; lastError = null
        val texts = b?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION).orEmpty()
        handle(texts)
        restart(150)
      }
      override fun onError(error: Int) {
        // Silence/no-match are normal: restart quickly. Other errors: exponential backoff, capped at 30s.
        val quick = error == SpeechRecognizer.ERROR_NO_MATCH || error == SpeechRecognizer.ERROR_SPEECH_TIMEOUT
        if (error == SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS) { lastError = "mic_permission"; shutdown(); return }
        if (quick) { failures = 0; restart(150); return }
        // 12 = ERROR_LANGUAGE_NOT_SUPPORTED, 13 = ERROR_LANGUAGE_UNAVAILABLE (API 31+): offline pack missing.
        if (useOnDevice && (error == 12 || error == 13)) { useOnDevice = false; restart(150); return }
        lastError = "recognizer_error_$error"
        failures++
        restart(minOf(30_000L, 500L shl minOf(failures, 6)))
      }
      override fun onReadyForSpeech(p: Bundle?) {}
      override fun onBeginningOfSpeech() {}
      override fun onRmsChanged(v: Float) {}
      override fun onBufferReceived(b: ByteArray?) {}
      override fun onEndOfSpeech() {}
      override fun onPartialResults(b: Bundle?) {}
      override fun onEvent(t: Int, b: Bundle?) {}
    })
    val i = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
      .putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
      .putExtra(RecognizerIntent.EXTRA_LANGUAGE, lang)
      .putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true)
      .putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 3)
      .putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 700L)
    try { r.startListening(i) } catch (e: Exception) { restart(2000) }
  }

  private fun restart(ms: Long) { if (running) main.postDelayed({ listen() }, ms) }

  private fun handle(texts: List<String>) {
    val now = System.currentTimeMillis()
    for (t in texts) {
      val cmd = extract(t)
      if (cmd != null) {
        armedUntil = now + 5 * 60_000 // say "NB" once, then 5 minutes without repeating it
        if (cmd.length >= 2) deliver(cmd) else deliver("") // "" = NB was called, web app replies "Yes?"
        return
      }
    }
    if (now < armedUntil && texts.isNotEmpty() && texts[0].trim().length >= 2) {
      armedUntil = now + 5 * 60_000
      deliver(texts[0].trim())
    }
  }

  /** Sends the command to the open web app, or opens NB / shows a tap-to-run notification. */
  private fun deliver(cmd: String) {
    val cb = onCommand
    if (cb != null && NbAppState.visible) { cb(cmd); return }
    pendingCommand = cmd
    val open = packageManager.getLaunchIntentForPackage(packageName)?.apply {
      addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)
      putExtra("nb_command", cmd)
    } ?: return
    try { startActivity(open) } catch (_: Exception) {}
    // Android 10+ may block the line above from the background; this notification always works.
    val pi = PendingIntent.getActivity(this, 2, open, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
    val n = Notification.Builder(this, "nb_heard")
      .setContentTitle(if (cmd.isEmpty()) "NB: Yes?" else "NB heard: $cmd")
      .setContentText("Tap to open NB")
      .setSmallIcon(android.R.drawable.ic_btn_speak_now)
      .setContentIntent(pi).setFullScreenIntent(pi, true).setAutoCancel(true).build()
    getSystemService(NotificationManager::class.java).notify(2, n)
  }

  private fun shutdown() {
    running = false
    main.removeCallbacksAndMessages(null)
    recognizer?.destroy(); recognizer = null
    wake?.let { if (it.isHeld) it.release() }; wake = null
    stopForeground(true); stopSelf()
  }

  override fun onDestroy() { if (running) shutdown(); super.onDestroy() }
}


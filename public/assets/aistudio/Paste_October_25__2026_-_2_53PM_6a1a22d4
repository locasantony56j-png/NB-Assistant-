        <div className="min-w-0">
          <p className="font-semibold">Say "NB" first</p>
          <p className="text-xs text-muted-foreground">NB only acts when you start with its name, e.g. "NB, Rahim ke call dao". Other talk is ignored.</p>
        </div>
        <Switch checked={settings.requireName} onCheckedChange={(v) => updateSettings({ requireName: v })} aria-label='Say "NB" first' />
      </div>
      <div className="mt-3 flex flex-wrap justify-center gap-2" role="group" aria-label="Listening language">

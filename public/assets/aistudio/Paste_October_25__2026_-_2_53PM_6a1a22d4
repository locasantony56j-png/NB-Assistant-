export function quickCommand(text: string, apps: { id: string; name: string }[]): { reply: string; steps: PlanStep[] } | null {
  const t = text.trim().replace(/[।.!?]+$/, "").trim();
  if (!t || t.length > 60) return null;
  const base = { app: null, contact: null, message: null, when: null, recurrence: null, sensitive: false } as const;
  // "youtube e natok dao", "youtube-e Tahsan er gaan chalao", "search on youtube cricket"
  const yt = t.match(/^(?:youtube|ইউটিউব)[\s-]*(?:e|te|এ|তে)?\s+(.+?)\s*(?:dao|daw|chalao|search koro|khojo|play koro|lagao|দাও|চালাও|খোঁজো|সার্চ করো)?$/i)
    ?? t.match(/^(?:search|play)\s+(.+?)\s+on\s+youtube$/i);
  const ytq = (yt?.[1] ?? "").trim();
  if (ytq.length >= 2 && !/^(kholo|khulo|open|খোলো)/i.test(ytq)) {
    const q = ytq;
    return { reply: `YouTube e "${q}" khujchi`, steps: [{ ...base, type: "search", app: "youtube", query: q }] };
  }
  for (const [re, query, reply] of QUICK) if (re.test(t)) return { reply, steps: [{ ...base, type: "device", query }] };
  const open = t.match(/^(.+?)\s*(kholo|khulo|open koro|chalu koro|খোলো|খুলো|চালু করো)$|^open\s+(.+)$/i);
  const raw = (open?.[1] ?? open?.[3] ?? "").trim().toLowerCase();
  if (raw) {
    const names = [raw, raw.replace(/[-‑\s](e|te|এ)$/i, "").trim()];
    const app = apps.find((a) => names.includes(a.name.toLowerCase()) || names.includes(a.id));
    if (app) return { reply: `${app.name} khulchi`, steps: [{ ...base, type: "open_app", app: app.id, query: null }] };
  }
  return null;
}


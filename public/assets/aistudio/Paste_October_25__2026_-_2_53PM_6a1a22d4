/* Bridge to the NB Android app (android-kit). Uses the Capacitor global the native shell injects,
   so the website works unchanged when it is not running inside the Android app. */
type Res = { ok?: boolean; launched?: boolean; reason?: string; [k: string]: unknown };
type Plugin = Record<string, (o?: object) => Promise<Res>> & { addListener?: (ev: string, cb: (d: Record<string, string>) => void) => unknown };
type Cap = { isNativePlatform?: () => boolean; Plugins?: Record<string, Plugin> };

const cap = (): Cap | null => (typeof window === "undefined" ? null : ((window as unknown as { Capacitor?: Cap }).Capacitor ?? null));

export const isNative = () => !!cap()?.isNativePlatform?.();

/** Calls a native plugin method. Returns null when not native or the plugin is missing. */
export async function nativeCall(plugin: string, method: string, opts?: object): Promise<Res | null> {
  const fn = cap()?.Plugins?.[plugin]?.[method];
  if (!isNative() || !fn) return null;
  try { return await fn(opts); } catch (e) { return { ok: false, reason: e instanceof Error ? e.message : "native_error" }; }
}

/** Subscribes to a native event (e.g. NbActions "ringing"). No-op on the website. */
export function nativeListen(plugin: string, event: string, cb: (d: Record<string, string>) => void) {
  if (!isNative()) return;
  cap()?.Plugins?.[plugin]?.addListener?.(event, cb);
}


def crashed(): return f"Process: {PKG}" in adb("logcat", "-d", "-b", "crash")

def record(name, ok, detail):
    results.append((name, ok, detail)); print(("PASS " if ok else "FAIL ") + name + " — " + detail, flush=True)

adb("install", "-r", "-g", APK, check=True)


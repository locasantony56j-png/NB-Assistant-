        <Button size="sm" variant="outline" className="mt-2" onClick={() => a.setAlwaysOn(true)}>Restart microphone</Button>
      )}
      {a.lastReply && <p className="mx-auto mt-2 max-w-md break-words rounded-xl bg-accent px-4 py-2 text-accent-foreground">{a.lastReply}</p>}


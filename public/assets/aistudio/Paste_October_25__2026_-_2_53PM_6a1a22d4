import type { Reminder } from "./store";

/** Next time a reminder should fire after it fired at `from`. Returns null for one-time reminders. */
export function nextOccurrence(r: Pick<Reminder, "when" | "recurrence">, from: Date = new Date(r.when)): Date | null {
  if (r.recurrence === "none") return null;
  const d = new Date(from);
  if (r.recurrence === "daily") d.setDate(d.getDate() + 1);
  else if (r.recurrence === "weekly") d.setDate(d.getDate() + 7);
  else if (r.recurrence === "weekdays") {
    do d.setDate(d.getDate() + 1);
    while (d.getDay() === 0 || d.getDay() === 6);
  }
  return d;
}

export function isDue(r: Reminder, now: Date = new Date()) {
  return !r.done && new Date(r.when).getTime() <= now.getTime();
}


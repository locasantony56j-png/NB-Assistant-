// UNTESTED. User-enabled in Android Settings -> Notification access.
// Keeps the last 30 notifications in memory only (never written to disk) so NB can read
// them aloud when asked ("WhatsApp e notun message ki?").
import android.app.Notification
import android.service.notification.NotificationListenerService
import android.service.notification.StatusBarNotification

class NbNotificationListener : NotificationListenerService() {
  data class Item(val pkg: String, val title: String, val text: String, val at: Long)
  companion object {
    @Volatile var connected = false
    private val items = ArrayDeque<Item>()
    @Synchronized fun recent(pkg: String?): List<Item> = items.filter { pkg.isNullOrBlank() || it.pkg == pkg }.takeLast(10)
    @Synchronized private fun add(i: Item) { items.removeAll { it.pkg == i.pkg && it.title == i.title && it.text == i.text }; items.addLast(i); while (items.size > 30) items.removeFirst() }
  }
  override fun onListenerConnected() { connected = true }
  override fun onListenerDisconnected() { connected = false }
  override fun onNotificationPosted(sbn: StatusBarNotification) {
    if (sbn.packageName == packageName || sbn.isOngoing) return
    val e = sbn.notification.extras
    val title = e.getCharSequence(Notification.EXTRA_TITLE)?.toString() ?: return
    val text = e.getCharSequence(Notification.EXTRA_TEXT)?.toString() ?: ""
    add(Item(sbn.packageName, title, text, sbn.postTime))
  }
}


// Builds public/source-code.txt: every text source file with a header.
// Run: node scripts/source-snapshot.mjs
import { readFileSync, writeFileSync, statSync, readdirSync } from "node:fs";
import { join } from "node:path";

const ROOT = process.cwd();
const SKIP_DIRS = new Set(["node_modules", "dist", ".git", ".lovable", ".tsh", "public", "tests"]);
const SKIP_FILES = new Set(["bun.lock", "bun.lockb", "package-lock.json", "yarn.lock", ".env"]);
const TEXT_EXT = /\.(ts|tsx|kt|kts|py|yml|yaml|xml|css|json|md|txt|mjs|cjs|sh|html|toml|properties|pro|gitignore|webmanifest)$/i;
const TEXT_NAMES = new Set(["Dockerfile", "Gemfile", "README", "LICENSE", ".gitignore", ".gitattributes"]);

function listFiles(dir) {
  const out = [];
  for (const name of readdirSync(dir)) {
    if (SKIP_FILES.has(name)) continue;
    const p = join(dir, name);
    const st = statSync(p);
    if (st.isDirectory()) {
      if (SKIP_DIRS.has(name)) continue;
      out.push(...listFiles(p));
    } else if (TEXT_EXT.test(name) || TEXT_NAMES.has(name.replace(/\..*$/, ""))) {
      if (st.size > 400_000) continue;
      out.push(p);
    }
  }
  return out;
}

const roots = ["src", "android-kit", ".github", "scripts"].map((d) => join(ROOT, d));
let files = [];
for (const r of roots) {
  try { files.push(...listFiles(r)); } catch { /* missing root is fine */ }
}
for (const f of readdirSync(ROOT)) {
  if (SKIP_FILES.has(f) || f.startsWith(".")) continue;
  const st = statSync(join(ROOT, f));
  if (st.isFile() && (TEXT_EXT.test(f) || f.endsWith(".config.js") || f === "index.html")) files.push(join(ROOT, f));
}
files = [...new Set(files)].sort();

let out = `NB Assistant — full app source code\nSnapshot generated: ${new Date().toISOString()}\nFiles: ${files.length}\n\n`;
let total = out.length;
for (const p of files) {
  const rel = p.slice(ROOT.length + 1);
  const body = readFileSync(p, "utf8");
  const chunk = `\n${"=".repeat(70)}\nFILE: ${rel}\n${"=".repeat(70)}\n${body}${body.endsWith("\n") ? "" : "\n"}`;
  out += chunk;
  total += chunk.length;
}
writeFileSync(join(ROOT, "public", "source-code.txt"), out);
console.log(`Wrote public/source-code.txt: ${files.length} files, ${(total / 1024).toFixed(0)} KB`);


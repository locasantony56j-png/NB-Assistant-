  };
  const save = () => {
    if (!draft) return;
    const w: Workflow = { id: uid(), name: draft.name, source: draft.source, steps: draft.steps.filter((s) => s.type !== "unsupported"), createdAt: new Date().toISOString() };
    setState((s) => ({ ...s, workflows: [w, ...s.workflows] }));

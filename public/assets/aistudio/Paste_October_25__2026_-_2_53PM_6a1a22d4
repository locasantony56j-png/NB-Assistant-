              <Button variant="ghost" size="icon" aria-label="Dismiss" onClick={() => a.dismissLink(l.actionId)}><X /></Button>
            </div>
          ))}
          <p className="text-xs text-muted-foreground">If nothing opened, tap the link — browsers sometimes block automatic opening.</p>
        </div>
      )}
    </section>
  );
}


#!/usr/bin/env python3
"""Copies android-kit into a fresh `npx cap add android` project. Used by GitHub Actions.
Usage: python3 android-kit/scripts/apply-kit.py <appId>"""
import pathlib, re, shutil, sys

app_id = sys.argv[1]
kit = pathlib.Path("android-kit")
app = pathlib.Path("android/app")
src = app / "src/main"
pkg_dir = src / "java" / pathlib.Path(*app_id.split("."))
pkg_dir.mkdir(parents=True, exist_ok=True)

# 1. Kotlin sources with the real package name
for kt in (kit / "kotlin").glob("*.kt"):
    text = kt.read_text().replace("package com.example.nb", f"package {app_id}", 1)
    (pkg_dir / kt.name).write_text(text)

# 2. MainActivity registers the plugins (Capacitor's template is Java)
for old in pkg_dir.glob("MainActivity.*"):
    old.unlink()
(pkg_dir / "MainActivity.java").write_text(f"""package {app_id};

import android.os.Bundle;
import com.getcapacitor.BridgeActivity;

public class MainActivity extends BridgeActivity {{
  @Override
  public void onCreate(Bundle savedInstanceState) {{
    registerPlugin(AppLauncherPlugin.class);
    registerPlugin(NbActionsPlugin.class);
    super.onCreate(savedInstanceState);
  }}
}}
""")

# 3. Accessibility XML
(src / "res/xml").mkdir(parents=True, exist_ok=True)
shutil.copy(kit / "res/xml/nb_accessibility.xml", src / "res/xml/nb_accessibility.xml")

# 4. Merge manifest snippet
snip = (kit / "AndroidManifest.snippet.xml").read_text()
perms = "\n".join(re.findall(r"<uses-permission[^>]*/>", snip))
queries = re.search(r"<queries>.*?</queries>", snip, re.S).group(0)
app_children = re.search(r"<application>(.*?)</application>", snip, re.S).group(1)
man_path = src / "AndroidManifest.xml"
man = man_path.read_text()
man = man.replace("<application", f"{perms}\n{queries}\n<application", 1)
man = man.replace("</application>", f"{app_children}\n</application>", 1)
man_path.write_text(man)

# 5. Enable Kotlin in Gradle
root = pathlib.Path("android/build.gradle")
r = root.read_text()
if "kotlin-gradle-plugin" not in r:
    r = re.sub(r"(dependencies\s*\{)", r"\1\n        classpath 'org.jetbrains.kotlin:kotlin-gradle-plugin:2.0.21'", r, count=1)
    root.write_text(r)
ab = app / "build.gradle"
a = ab.read_text()
if "kotlin-android" not in a:
    a = a.replace("apply plugin: 'com.android.application'", "apply plugin: 'com.android.application'\napply plugin: 'kotlin-android'", 1)
    ab.write_text(a)

print("android-kit applied to", pkg_dir)


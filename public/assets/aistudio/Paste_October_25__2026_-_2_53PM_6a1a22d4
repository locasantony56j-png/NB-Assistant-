      </form>

      {a.links.length > 0 && (
        <div className="mx-auto mt-4 max-w-lg space-y-2 text-left">
          {a.links.map((l) => (
            <div key={l.actionId} className="flex items-center gap-2 rounded-lg border p-2 text-sm">
              <a href={l.url} target="_blank" rel="noopener noreferrer" className="flex min-w-0 flex-1 items-center gap-2 font-medium text-primary">

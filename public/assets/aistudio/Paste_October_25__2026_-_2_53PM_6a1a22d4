#!/usr/bin/env python3
"""Automated Android EMULATOR smoke tests for the NB debug APK (run by GitHub Actions).
Covers: app startup, microphone permission denial, Always-listening On/Off switch.
Does NOT cover background / screen-off listening — that needs a real phone (see REAL_PHONE list)."""
import os, re, subprocess, sys, time, xml.etree.ElementTree as ET

APK, PKG = sys.argv[1], sys.argv[2]
results: list[tuple[str, bool, str]] = []

def adb(*a, check=False):
    return subprocess.run(["adb", *a], capture_output=True, text=True, check=check).stdout

def nodes():
    adb("shell", "uiautomator", "dump", "/sdcard/ui.xml")
    xml = adb("exec-out", "cat", "/sdcard/ui.xml")
    try: return list(ET.fromstring(xml).iter("node"))
    except ET.ParseError: return []

def find(pattern, timeout=40):
    rx = re.compile(pattern, re.I); end = time.time() + timeout
    while time.time() < end:
        for n in nodes():
            if rx.search(n.get("text", "")) or rx.search(n.get("content-desc", "")): return n
        time.sleep(2)
    return None

def tap(n):
    x1, y1, x2, y2 = map(int, re.findall(r"\d+", n.get("bounds")))
    adb("shell", "input", "tap", str((x1 + x2) // 2), str((y1 + y2) // 2))

def alive(): return adb("shell", "pidof", PKG).strip() != ""

def launch():

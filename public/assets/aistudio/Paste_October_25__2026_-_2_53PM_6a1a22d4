                  {!nstat.battery && <Button size="sm" variant="outline" onClick={() => void nativeCall("NbActions", "openBatterySettings")}>Fix</Button>}</li>
                {nstat.reason && <li className="text-destructive">Last problem: {nstat.reason.replace(/_/g, " ")}</li>}

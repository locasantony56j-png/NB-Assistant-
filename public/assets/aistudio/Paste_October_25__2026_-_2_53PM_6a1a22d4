package com.example.nb

// UNTESTED starting point. Capacitor plugin exposing phone actions NB can do natively.
// Every method resolves { ok: boolean, reason? } so the web app logs truthful statuses.
import android.Manifest
import android.content.Intent
import android.content.pm.PackageManager
import android.net.Uri
import android.provider.AlarmClock
import android.provider.MediaStore
import android.telecom.TelecomManager
import androidx.core.content.ContextCompat
import com.getcapacitor.JSObject
import com.getcapacitor.Plugin
import com.getcapacitor.PluginCall
import com.getcapacitor.PluginMethod
import com.getcapacitor.annotation.CapacitorPlugin

@CapacitorPlugin(name = "NbActions")
class NbActionsPlugin : Plugin() {

  /** Forwards "phone is ringing" to the web app so NB can ask: receive or decline? */
  override fun load() {
    NbCallReceiver.onRinging = { n -> notifyListeners("ringing", JSObject().put("number", n ?: "")) }
    VoiceForegroundService.onCommand = { c -> activity?.runOnUiThread { notifyListeners("command", JSObject().put("text", c)) } }
    NbAppState.visible = true
  }

  override fun handleOnResume() { NbAppState.visible = true; deliverPending() }
  override fun handleOnPause() { NbAppState.visible = false }
  override fun handleOnNewIntent(intent: Intent) {
    intent.getStringExtra("nb_command")?.let { VoiceForegroundService.pendingCommand = it }
    deliverPending()
  }

  private fun deliverPending() {
    val c = VoiceForegroundService.pendingCommand ?: return
    VoiceForegroundService.pendingCommand = null
    notifyListeners("command", JSObject().put("text", c), true)
  }

  /** Starts background "NB" listening (must be called while NB is on screen). */
  @PluginMethod fun startBackgroundListening(call: PluginCall) {
    if (!has(Manifest.permission.RECORD_AUDIO)) return res(call, false, "mic_permission")
    askNotifications()
    VoiceForegroundService.start(context, call.getString("lang") ?: "bn-BD")
    res(call, true)
  }

  /** Android 13+: the "NB is listening" / "NB heard" notices are hidden unless the user allows notifications. */
  private fun askNotifications() {
    if (android.os.Build.VERSION.SDK_INT >= 33 && !has(Manifest.permission.POST_NOTIFICATIONS)) {
      activity?.let { androidx.core.app.ActivityCompat.requestPermissions(it, arrayOf(Manifest.permission.POST_NOTIFICATIONS), 4401) }
    }
  }

  @PluginMethod fun stopBackgroundListening(call: PluginCall) { VoiceForegroundService.stop(context); res(call, true) }

  /** Truthful status: is the background service actually running, and did it hit a problem? */
  @PluginMethod fun backgroundStatus(call: PluginCall) {
    val pm = context.getSystemService(android.os.PowerManager::class.java)
    call.resolve(JSObject()
      .put("ok", VoiceForegroundService.running)
      .put("reason", VoiceForegroundService.lastError ?: "")
      .put("mic", has(Manifest.permission.RECORD_AUDIO))
      .put("batteryUnrestricted", pm?.isIgnoringBatteryOptimizations(context.packageName) == true))
  }

  /** Picks up a command heard while NB was closed (web app calls this on startup). */
  @PluginMethod fun takePendingCommand(call: PluginCall) {
    val c = VoiceForegroundService.pendingCommand
    VoiceForegroundService.pendingCommand = null
    call.resolve(JSObject().put("ok", c != null).put("text", c ?: ""))
  }

  /** Opens the system screen to let NB ignore battery optimisation (needed for screen-off listening). */
  @PluginMethod fun openBatterySettings(call: PluginCall) {
    res(call, start(Intent(android.provider.Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, Uri.parse("package:" + context.packageName))), "no_settings")
  }

  private fun res(call: PluginCall, ok: Boolean, reason: String? = null) =
    call.resolve(JSObject().put("ok", ok).apply { if (reason != null) put("reason", reason) })

  private fun has(p: String) = ContextCompat.checkSelfPermission(context, p) == PackageManager.PERMISSION_GRANTED

  private fun start(i: Intent): Boolean {
    i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
    if (i.resolveActivity(context.packageManager) == null) return false
    context.startActivity(i); return true
  }

  /** Alarm via the Clock app. skipUi=true sets it silently on most phones. */
  @PluginMethod fun setAlarm(call: PluginCall) {

# Builds an UNSIGNED debug APK of NB from android-kit. Run it from GitHub → Actions → "Android debug APK" → Run workflow.
# The APK loads the published NB website inside a native shell that adds the android-kit plugins.
name: Android debug APK

on:
  workflow_dispatch:
    inputs:
      app_url:
        description: "Published NB URL the app opens"
        default: "https://nb-voice-assistant.lovable.app"
      app_id:
        description: "Android application ID"
        default: "com.nb.assistant"

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      APP_URL: ${{ github.event.inputs.app_url || 'https://nb-voice-assistant.lovable.app' }}
      APP_ID: ${{ github.event.inputs.app_id || 'com.nb.assistant' }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - uses: android-actions/setup-android@v3

      - name: Create native shell (separate folder, app code untouched)
        run: |
          mkdir -p /tmp/shell/www && cd /tmp/shell
          echo '<!doctype html><title>NB</title><p>Loading NB…</p>' > www/index.html
          npm init -y >/dev/null
          npm i @capacitor/core@7 @capacitor/cli@7 @capacitor/android@7
          cat > capacitor.config.json <<EOF
          { "appId": "$APP_ID", "appName": "NB Assistant", "webDir": "www",
            "server": { "url": "$APP_URL", "cleartext": false } }
          EOF
          npx cap add android
          cp -r "$GITHUB_WORKSPACE/android-kit" .
          python3 android-kit/scripts/apply-kit.py "$APP_ID"
          npx cap sync android

      - name: Build debug APK
        working-directory: /tmp/shell/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon --stacktrace

      - uses: actions/upload-artifact@v4
        with:
          name: nb-debug-apk
          path: /tmp/shell/android/app/build/outputs/apk/debug/*.apk

      # Direct phone-friendly link: https://github.com/<you>/<repo>/releases/latest/download/nb-debug.apk
      - name: Publish APK as a release (direct download link)
        run: |
          cp /tmp/shell/android/app/build/outputs/apk/debug/app-debug.apk nb-debug.apk
          gh release delete nb-latest -y --cleanup-tag || true
          gh release create nb-latest nb-debug.apk --latest --repo "$GITHUB_REPOSITORY" --title "NB Android app (test build)" --notes "Unsigned debug build for testing."
          LINK="https://github.com/$GITHUB_REPOSITORY/releases/latest/download/nb-debug.apk"
          { echo "## APK download link"; echo ""; echo "$LINK"; echo ""; echo "Send this link to NB chat so the Download button can be switched on."; } >> "$GITHUB_STEP_SUMMARY"
        env:
          GH_TOKEN: ${{ github.token }}

  smoke-test:
    # Automated checks on an Android emulator. Background/screen-off listening is NOT covered — see the job summary.
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 40
    env:
      APP_ID: ${{ github.event.inputs.app_id || 'com.nb.assistant' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          name: nb-debug-apk
          path: apk
      - name: Enable KVM
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules && sudo udevadm trigger --name-match=kvm
      - name: Run smoke tests on emulator
        uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 34
          target: google_apis
          arch: x86_64
          disable-animations: true
          script: python3 android-kit/smoke/smoke.py "$(ls apk/*.apk | head -1)" "$APP_ID"

